# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
DATABASE_URL=            # Neon connection string (added automatically if you connect Neon through Vercel)
RESEND_API_KEY=          # from resend.com → API Keys
EMAIL_FROM=Spark <onboarding@resend.dev>   # change to e.g. Spark <hello@yourdomain.com> after verifying your domain
ADMIN_PASSWORD=          # password for /admin
CRON_SECRET=             # any long random string; Vercel Cron sends it automatically
APP_URL=                 # optional: your public address, e.g. https://spark-xyz.vercel.app (used in email links)
